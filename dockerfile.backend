# Dockerfile.backend
FROM python:3.10-slim

# Evita que Python escriba archivos .pyc y fuerza el output en la terminal
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instalar dependencias del sistema necesarias para compilar algunas librerías
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar los requerimientos
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Descargar el modelo de NLP de spaCy que usa tu procesador de documentos
RUN python -m spacy download es_core_news_sm

# Copiar el código fuente
COPY src/ ./src/

# Hacemos que la carpeta src sea el directorio de trabajo para que funcionen tus imports (ej: from domain.document...)
WORKDIR /app/src

EXPOSE 8000

# Usamos 0.0.0.0 en lugar de localhost para que el puerto sea accesible desde fuera del contenedor
CMD ["uvicorn", "infrastructure.api:app", "--host", "0.0.0.0", "--port", "8000"]